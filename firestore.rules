rules_version = '2';
// Pick'em Room security rules. Paste into Firebase console → Firestore Database → Rules (replace EVERYTHING) → Publish.
// Everyone who opens the link is signed in anonymously (no account). Each player can only write their own player document
// and their own lines. The commissioner (the first person to open the page, or anyone signed in with the commissioner's
// Google email) can write everything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function cfg() { return get(/databases/$(database)/documents/config/app).data; }
    function isCommish() {
      return signedIn() && exists(/databases/$(database)/documents/config/app) && (
        cfg().commissionerUid == request.auth.uid
        || ('email' in request.auth.token && 'commissionerEmail' in cfg() && request.auth.token.email == cfg().commissionerEmail)
      );
    }
    match /config/app {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.commissionerUid == request.auth.uid;
      allow update: if isCommish();
    }
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isCommish());
      allow delete: if isCommish();
    }
    match /lines/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (
        (request.resource.data.uid == request.auth.uid && docId == request.auth.uid + '_' + request.resource.data.wk)
        || isCommish());
      allow delete: if isCommish();
    }
    match /book/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isCommish();
    }
    match /overrides/{gameId} {
      allow read: if signedIn();
      allow write: if isCommish();
    }
  }
}
